# =============================================================================
# CardioPulse AI - Environment Configuration Template
# =============================================================================

# Application Meta
PROJECT_NAME="CardioPulse AI - Clinical Decision Support Platform"
API_V1_STR=/api/v1

# Security & Session Authentication
# In production, generate a cryptographically strong 64-character random string
SECRET_KEY=cardiopulse-clinical-security-key-production-ready-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: Local SQLite with WAL mode
DATABASE_URL=sqlite+aiosqlite:///./cardiopulse.db
# Production PostgreSQL URI:
# DATABASE_URL=postgresql+asyncpg://cardiopulse_user:cardiopulse_secure_2026@localhost:5432/cardiopulse

# AI / LLM Configuration
# Optional: Set Google Gemini API Key for natural language cardiovascular advice
# If unset, the deterministic clinical NLP engine executes with zero external dependencies
GEMINI_API_KEY=
AI_FALLBACK_MODE=true

# Regional Emergency Ambulance Hotline (e.g. 112 for EU/India, 911 for US/Canada, 999 for UK)
EMERGENCY_AMBULANCE_NUMBER=112

# Server Deployment Port
PORT=8000
HOST=127.0.0.1

